# ==============================================================================
# CloudGuard Configuration - Local MVP Safe Defaults
# ==============================================================================

# Server Network & Runtime Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=false

# LLM Configuration (Offline mock provider enabled by default)
# Operates fully offline without requiring cloud API keys or external credits
LLM_PROVIDER=mock
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=gpt-4o-mini

# Alerting & Webhooks (Disabled by default)
ENABLE_SLACK_NOTIFICATIONS=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Auto-Remediation Safety Controls
# - AUTO_REMEDIATION_ENABLED is FALSE for safety
# - DRY_RUN is TRUE (computes and logs planned fixes without executing live changes)
# - REQUIRE_APPROVAL_FOR_MEDIUM_RISK is TRUE (enforces human-in-the-loop)
AUTO_REMEDIATION_ENABLED=false
DRY_RUN=true
REQUIRE_APPROVAL_FOR_MEDIUM_RISK=true
